# ------------------------------------------------------------------
# AfriCard — configuration. Copiez ce fichier en .env (jamais commité).
# ------------------------------------------------------------------
NODE_ENV=production
PORT=3000
PUBLIC_URL=https://app.votre-domaine.com
DB_PATH=data/africard.db

# Secrets OBLIGATOIRES en production (générez-les avec : openssl rand -hex 32)
JWT_SECRET=
# 64 caractères hex : chiffre PAN, CVV, pièces d'identité, secrets 2FA
DATA_ENCRYPTION_KEY=
MM_SANDBOX_WEBHOOK_SECRET=

ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=30

# "sandbox" = simulation complète ; "live" = vrais agrégateurs Mobile Money
MOBILE_MONEY_MODE=sandbox
CARD_ISSUER_MODE=sandbox
SANDBOX_AUTO_APPROVE_KYC=false

# Tarification (points de base : 100 = 1 %)
FEE_DEPOSIT_BPS=100
FEE_WITHDRAWAL_BPS=150
FEE_FX_SPREAD_BPS=150
FEE_CARD_CREATION_USD_CENTS=200
FEE_CARD_CROSS_CCY_BPS=100
FEE_P2P_BPS=0

# Cours de change en direct (sinon cours de référence intégrés)
FX_LIVE=false
FX_LIVE_URL=https://open.er-api.com/v6/latest/USD
FX_QUOTE_TTL_SEC=60

# --- Agrégateurs Mobile Money (mode live) ---
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=
PAWAPAY_API_TOKEN=
PAWAPAY_BASE_URL=https://api.sandbox.pawapay.io
PAWAPAY_WEBHOOK_SECRET=

# --- Documents juridiques (changer la version force la ré-acceptation) ---
PRIVACY_POLICY_VERSION=2026-11-21
TERMS_VERSION=2026-11-21
COMPANY_NAME=AFRICAGRO
DPO_EMAIL=
SUPPORT_EMAIL=

# --- Agents automatiques ---
AGENTS_ENABLED=true
AGENT_SECURITY_INTERVAL_SEC=60
AGENT_RELIABILITY_INTERVAL_SEC=300
AGENT_NOTIFICATION_INTERVAL_SEC=30
AML_SINGLE_TX_USD_CENTS=500000
AML_DAILY_USD_CENTS=1000000
PENDING_DEPOSIT_EXPIRY_MIN=30

# --- Notifications utilisateurs ---
# console | resend | brevo
NOTIFY_EMAIL_PROVIDER=console
EMAIL_FROM=AfriCard <no-reply@votre-domaine.com>
RESEND_API_KEY=
BREVO_API_KEY=
# console | africastalking | twilio
NOTIFY_SMS_PROVIDER=console
SMS_SENDER_ID=AfriCard
AT_USERNAME=
AT_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# --- Alertes équipe (sécurité, bugs, conformité) ---
# Slack / Discord / Teams
ADMIN_ALERT_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# séparés par des virgules (alertes critiques)
ADMIN_ALERT_EMAILS=
