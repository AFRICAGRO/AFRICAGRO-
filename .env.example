# ------------------------------------------------------------------
# AfriCard — configuration. Copiez ce fichier en .env (jamais commité).
# ------------------------------------------------------------------
NODE_ENV=production
PORT=3000
PUBLIC_URL=https://app.votre-domaine.com
DB_PATH=data/africard.db

# Secrets OBLIGATOIRES en production (générez-les avec : openssl rand -hex 32)
JWT_SECRET=
DATA_ENCRYPTION_KEY=          # 64 caractères hex : chiffre PAN, CVV, pièces d'identité, secrets 2FA
MM_SANDBOX_WEBHOOK_SECRET=

ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=30

# "sandbox" = simulation complète ; "live" = vrais agrégateurs Mobile Money
MOBILE_MONEY_MODE=sandbox
CARD_ISSUER_MODE=sandbox
SANDBOX_AUTO_APPROVE_KYC=false

# Tarification (points de base : 100 = 1 %)
FEE_DEPOSIT_BPS=100
FEE_WITHDRAWAL_BPS=150
FEE_FX_SPREAD_BPS=150
FEE_CARD_CREATION_USD_CENTS=200
FEE_CARD_CROSS_CCY_BPS=100
FEE_P2P_BPS=0

# Cours de change en direct (sinon cours de référence intégrés)
FX_LIVE=false
FX_LIVE_URL=https://open.er-api.com/v6/latest/USD
FX_QUOTE_TTL_SEC=60

# --- Agrégateurs Mobile Money (mode live) ---
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=
PAWAPAY_API_TOKEN=
PAWAPAY_BASE_URL=https://api.sandbox.pawapay.io
PAWAPAY_WEBHOOK_SECRET=
